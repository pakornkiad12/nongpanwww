<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>เว็บไซต์ของน้องปัน</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Tahoma", sans-serif;
            color: #333;

            background-image:
                linear-gradient(
                    rgba(255,255,255,0.45),
                    rgba(255,255,255,0.45)
                ),
                url("sakayanagi.jpg");

            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;

            line-height: 1.8;
        }

        /* ส่วนหัว */
        header {
            text-align: center;
            background: rgba(80, 50, 120, 0.80);
            color: white;
            padding: 35px 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        header h1 {
            font-size: 40px;
            text-shadow: 2px 2px 5px #222;
        }

        header p {
            font-size: 18px;
        }

        /* เมนู */
        nav {
            text-align: center;
            background: rgba(255,255,255,0.92);
            padding: 15px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 3px 12px rgba(0,0,0,0.2);
        }

        nav a {
            display: inline-block;
            color: #5b2c83;
            text-decoration: none;
            font-weight: bold;
            margin: 5px;
            padding: 8px 18px;
            border-radius: 25px;
            transition: 0.3s;
        }

        nav a:hover {
            background: #6a5acd;
            color: white;
            transform: translateY(-2px);
        }

        /* กล่องเนื้อหา */
        .container {
            max-width: 1000px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .card {
            background: rgba(255,255,255,0.90);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;

            box-shadow:
                0 8px 25px rgba(0,0,0,0.25);

            backdrop-filter: blur(4px);
        }

        .card h2 {
            color: #663399;
            text-align: center;
            margin-bottom: 25px;
        }

        /* =========================
           ส่วนโปรไฟล์
        ========================= */

        .profile-content {
            display: flex;
            align-items: center;
            gap: 45px;
        }

        /* รูปอยู่ด้านซ้าย */
        .profile-left {
            flex: 1;
            text-align: center;
        }

        .profile-img {
            width: 280px;
            height: 280px;
            object-fit: cover;

            border-radius: 50%;
            border: 8px solid white;

            box-shadow:
                0 5px 25px rgba(0,0,0,0.35);

            transition: 0.4s;
        }

        .profile-img:hover {
            transform: scale(1.05);
        }

        /* ข้อมูลอยู่ด้านขวา */
        .profile-right {
            flex: 1;
        }

        .profile-right h2 {
            text-align: left;
            margin-bottom: 15px;
        }

        .info p {
            background: rgba(245,240,255,0.9);
            padding: 12px 18px;
            margin: 10px 0;
            border-radius: 12px;
            border-left: 5px solid #6a5acd;
        }

        .green {
            color: #228b22;
            font-weight: bold;
        }

        .red {
            color: #e60000;
            font-weight: bold;
        }

        .purple {
            color: #663399;
            font-weight: bold;
        }

        .orange {
            color: #f6850c;
            font-weight: bold;
        }

        /* มังงะ */
        .manga {
            background: rgba(255,245,250,0.92);
        }

        .manga h2 {
            color: #e75480;
        }

        .manga p {
            text-align: left;
        }

        /* =========================
           ลิงก์เว็บไซต์
        ========================= */

        .links {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            max-width: 700px;
            margin: auto;
        }

        .link-button {
            display: block;
            text-decoration: none;
            color: white;
            background: linear-gradient(135deg, #6a5acd, #8a2be2);

            padding: 15px 20px;
            border-radius: 15px;

            text-align: center;
            font-weight: bold;
            font-size: 17px;

            box-shadow: 0 5px 12px rgba(0,0,0,0.2);

            transition: 0.3s;
        }

        .link-button:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 8px 18px rgba(0,0,0,0.3);
            background: linear-gradient(135deg, #8a2be2, #6a5acd);
        }

        /* ตาราง */
        table {
            width: 80%;
            margin: 20px auto;
            border-collapse: collapse;
            background: rgba(255,255,255,0.95);

            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        }

        th,
        td {
            border: 1px solid #aaa;
            padding: 14px;
            text-align: center;
        }

        th {
            background: #6a5acd;
            color: white;
        }

        tr:nth-child(even) {
            background: #f5f0ff;
        }

        tr:hover {
            background: #e8ddff;
        }

        /* Footer */
        footer {
            text-align: center;
            background: rgba(40,40,40,0.90);
            color: white;
            padding: 25px;
            margin-top: 40px;
        }

        /* =========================
           มือถือ
        ========================= */

        @media (max-width: 700px) {

            header h1 {
                font-size: 28px;
            }

            nav a {
                display: block;
                margin: 5px 20px;
            }

            /* มือถือให้รูปอยู่ด้านบน ข้อมูลอยู่ด้านล่าง */
            .profile-content {
                flex-direction: column;
                gap: 20px;
            }

            .profile-img {
                width: 200px;
                height: 200px;
            }

            .profile-right {
                width: 100%;
            }

            .profile-right h2 {
                text-align: center;
            }

            .links {
                grid-template-columns: 1fr;
            }

            table {
                width: 100%;
            }

            .card {
                padding: 20px;
            }
        }
    </style>
</head>


<body>

